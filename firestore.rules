rules_version = '2';

// คัดลอกไปวางที่ Firebase Console > Firestore Database > Rules แล้วกด Publish
// ผู้ใช้แต่ละคนอ่าน/เขียนได้เฉพาะข้อมูลของตัวเอง
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // ตัวเลขเงิน: มากกว่า 0 และไม่เกินพันล้าน (กันค่าขยะ)
    function validAmount(v) {
      return v is number && v > 0 && v <= 1000000000;
    }

    // ข้อความสั้นๆ (หน้าเว็บจำกัด 100 ตัว เผื่อไว้ 200)
    function shortText(d, field) {
      return !(field in d) || (d[field] is string && d[field].size() <= 200);
    }

    function validTransaction() {
      let d = request.resource.data;
      return d.userId == request.auth.uid
        && d.keys().hasOnly(['userId', 'amount', 'type', 'category', 'date', 'note', 'createdAt', 'recurringId'])
        && validAmount(d.amount)
        && d.type in ['income', 'expense']
        && d.category is string && d.category.size() <= 50
        && d.date is timestamp
        && shortText(d, 'note')
        && shortText(d, 'recurringId');
    }

    function validRecurring() {
      let d = request.resource.data;
      return d.userId == request.auth.uid
        && d.keys().hasOnly(['userId', 'type', 'amount', 'category', 'note', 'day', 'startMonth', 'lastPosted', 'active', 'createdAt'])
        && validAmount(d.amount)
        && d.type in ['income', 'expense']
        && d.category is string && d.category.size() <= 50
        && d.day is int && d.day >= 1 && d.day <= 31
        && shortText(d, 'note');
    }

    // budgets/{uid} = { budget, monthly: { "YYYY-MM": number|null }, categories: { key: number } }
    function validBudget() {
      let d = request.resource.data;
      return d.keys().hasOnly(['budget', 'monthly', 'categories'])
        && (!('budget' in d) || d.budget is number)
        && (!('monthly' in d) || (d.monthly is map && d.monthly.size() <= 600))
        && (!('categories' in d) || (d.categories is map && d.categories.size() <= 50));
    }

    match /transactions/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validTransaction();
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && validTransaction();
    }

    // รายการประจำ (ค่าเช่า เงินเดือน ฯลฯ)
    match /recurring/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
      allow create: if signedIn() && validRecurring();
      allow update: if signedIn()
        && resource.data.userId == request.auth.uid
        && validRecurring();
    }

    match /budgets/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
      allow write: if signedIn() && request.auth.uid == uid && validBudget();
    }

    // LINE: server (admin SDK) เป็นคนเขียน หน้าเว็บอ่าน/ลบได้เฉพาะของตัวเอง
    match /lineLinks/{lineUserId} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /lineDicts/{uid} {
      allow read, delete: if signedIn() && request.auth.uid == uid;
    }

    match /lineDrafts/{id} {
      allow read, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    // lineUsage: ไม่มี rule = หน้าเว็บอ่าน/เขียนไม่ได้ (กันลบตัวนับเพื่อหลบเกณฑ์จำกัด)
  }
}
